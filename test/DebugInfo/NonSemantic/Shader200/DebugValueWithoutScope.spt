; A DebugValue/DebugDeclare may appear without an active DebugScope. Such an
; instruction cannot be given a location straight from the (absent) DebugScope,
; but reverse translation can still recover a verifier-correct DILocation from
; the variable itself when the variable belongs to the function currently being
; emitted: the variable's own line and scope are used. Only when the variable's
; scope belongs to a *different* subprogram (an inlined variable, whose
; DILocation would require an inlinedAt that only the missing DebugScope
; carries) must the intrinsic be dropped, as it cannot be represented.
; See SPIRVToLLVMDbgTran::transDebugIntrinsic.
;
; The instructions exercised in foo's body are:
;  - "a" and "b": DebugValue without a DebugScope whose variable is scoped to
;    foo (the function being emitted). Recovered as scope-local dbg.values.
;  - "d": DebugDeclare without a DebugScope whose variable operand is
;    DebugInfoNone. Recovered as a dbg.declare of a dummy value, taking the
;    same variable-derived location as the DebugValue case.
;  - "c": DebugValue without a DebugScope whose variable is scoped to a
;    *different* subprogram (bar). Unrepresentable inlined variable, dropped.
;  - "e": DebugValue *with* a DebugScope that has an inlinedAt operand and a
;    variable scoped to another subprogram (baz). This is a well-formed inlined
;    variable, so it is kept and its DILocation carries the inlinedAt chain.
;
; foo is a plain spir_func (exported, no OpEntryPoint) so its DebugFunction maps
; one-to-one onto the emitted define; there is no kernel entry-point wrapper that
; would be merged into the debug-bearing function and blur which define the
; recovered records land in.

; RUN: llvm-spirv -to-binary %s -o %t.spv
; RUN: llvm-spirv -r %t.spv -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc -o %t.rev.ll
; RUN: FileCheck < %t.rev.ll %s -check-prefix=CHECK-LLVM
; RUN: FileCheck < %t.rev.ll %s --check-prefix=CHECK-DROP

; The module must translate cleanly and pass the verifier. The function-local
; variables keep a debug record with a location scoped to foo's subprogram, the
; inlined variable "e" keeps a location with an inlinedAt chain, and the
; unrepresentable inlined variable "c" (and its subprogram "bar") is dropped.
; RUN: opt -passes=verify -disable-output %t.rev.bc 2>&1 \
; RUN:  | FileCheck %s --allow-empty --check-prefix=CHECK-VERIFY

; CHECK-LLVM: define spir_func void @foo(i32 %a){{.*}} !dbg ![[#SP:]]
; CHECK-LLVM: #dbg_value(i32 %a, ![[#VARA:]], !DIExpression(), ![[#LOCA:]])
; CHECK-LLVM: #dbg_value(i32 %b, ![[#VARB:]], !DIExpression(), ![[#LOCB:]])
; CHECK-LLVM: #dbg_declare(ptr {{null|undef|poison}}, ![[#VARD:]], !DIExpression(), ![[#LOCD:]])
; CHECK-LLVM: #dbg_value(i32 %b, ![[#VARE:]], !DIExpression(), ![[#LOCE:]])

; CHECK-LLVM-DAG: ![[#SP]] = distinct !DISubprogram(name: "foo"
; CHECK-LLVM-DAG: ![[#VARA]] = !DILocalVariable(name: "a", arg: 1, scope: ![[#SP]]
; CHECK-LLVM-DAG: ![[#VARB]] = !DILocalVariable(name: "b", scope: ![[#SP]]
; CHECK-LLVM-DAG: ![[#VARD]] = !DILocalVariable(name: "d", scope: ![[#SP]]
; CHECK-LLVM-DAG: ![[#LOCA]] = !DILocation(line: 1, scope: ![[#SP]])
; CHECK-LLVM-DAG: ![[#LOCB]] = !DILocation(line: 2, scope: ![[#SP]])
; CHECK-LLVM-DAG: ![[#LOCD]] = !DILocation(line: 3, scope: ![[#SP]])

; The inlined variable "e" is scoped to a different subprogram (baz) and its
; location must carry an inlinedAt back to the call site in foo.
; CHECK-LLVM-DAG: ![[#VARE]] = !DILocalVariable(name: "e", scope: ![[#BAZ:]]
; CHECK-LLVM-DAG: ![[#BAZ]] = distinct !DISubprogram(name: "baz"
; CHECK-LLVM-DAG: ![[#LOCE]] = !DILocation(line: 2, column: 1, scope: ![[#BAZ]], inlinedAt: ![[#IA:]])
; CHECK-LLVM-DAG: ![[#IA]] = distinct !DILocation(line: 1, scope: ![[#SP]])

; The unrepresentable inlined variable and its subprogram must not be emitted.
; CHECK-DROP-NOT: name: "c"
; CHECK-DROP-NOT: name: "bar"

; CHECK-VERIFY-NOT: invalid debug info
; CHECK-VERIFY-NOT: conflicting debug info
; CHECK-VERIFY-NOT: attachment points at wrong subprogram

